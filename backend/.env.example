# Copy to .env (gitignored). Never commit real values.
# In production these are set in the Render dashboard (Environment), not in files.
ENV=development
# Local Postgres (docker compose up db) or a Neon connection string
DATABASE_URL=postgresql+psycopg://kaagaz:kaagaz@localhost:5432/kaagaz
# At least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173
# "demo" = offline rule-based provider (no API calls). "sarvam" = real Sarvam APIs (paid credits).
AI_PROVIDER=demo
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b
